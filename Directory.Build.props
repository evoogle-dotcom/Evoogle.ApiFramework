<Project>
  <Import
      Project="$(MSBuildThisFileDirectory)Directory.Build.evoogle-core.local.props"
      Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.evoogle-core.local.props')" />
  <Import
      Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
      Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <UseLocalEvoogleProjectReferences Condition="'$(UseLocalEvoogleProjectReferences)' == ''">
      false
    </UseLocalEvoogleProjectReferences>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition="
      '$(IsTestProject)' == 'true'
      Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))
      Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.UnitTests'))
      Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.IntegrationTests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
