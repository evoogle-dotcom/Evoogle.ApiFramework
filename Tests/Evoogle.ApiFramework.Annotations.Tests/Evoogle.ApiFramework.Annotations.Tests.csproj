<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Evoogle.ApiFramework</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Evoogle.XUnit" Version="$(EvoogleXUnitPackageVersion)" Condition="'$(UseLocalEvoogleProjectReferences)' != 'true'&#xD;&#xA;                                 And '$(EvoogleXUnitPackageVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Evoogle.ApiFramework.Annotations\Evoogle.ApiFramework.Annotations.csproj" />
    <ProjectReference Include="..\..\..\evoogle-core\Source\Evoogle.XUnit\Evoogle.XUnit.csproj" Condition="'$(UseLocalEvoogleProjectReferences)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateEvoogleXUnitPackageVersion" BeforeTargets="Restore;PrepareForBuild" Condition="'$(UseLocalEvoogleProjectReferences)' != 'true'&#xD;&#xA;                     And '$(EvoogleXUnitPackageVersion)' == ''">
    <Error Text="Configure XUnit package version or enable local project references." />
  </Target>

</Project>
