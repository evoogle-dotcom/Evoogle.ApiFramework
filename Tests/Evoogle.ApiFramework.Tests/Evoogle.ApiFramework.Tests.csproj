<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Evoogle.ApiFramework</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Evoogle.XUnit"
                      Version="$(EvoogleXUnitPackageVersion)"
                      Condition="'$(UseLocalEvoogleProjectReferences)' != 'true'
                                 And '$(EvoogleXUnitPackageVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Evoogle.ApiFramework\Evoogle.ApiFramework.csproj" />
    <ProjectReference Include="..\..\..\evoogle-core\Source\Evoogle.XUnit\Evoogle.XUnit.csproj"
                      Condition="'$(UseLocalEvoogleProjectReferences)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateEvoogleXUnitPackageVersion"
          BeforeTargets="Restore;PrepareForBuild"
          Condition="'$(UseLocalEvoogleProjectReferences)' != 'true'
                     And '$(EvoogleXUnitPackageVersion)' == ''">
    <Error Text="Configure XUnit package version or enable local project references." />
  </Target>

</Project>
